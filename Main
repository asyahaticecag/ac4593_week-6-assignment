"""
main.py -- Cosy Bedroom Generator
=====================================
DIGM 131 - Week 6 | Author: Asya Hatice Cag | Drexel University

Assembles a complete cosy bedroom using the geometry and
material modules. All dimensions and positions are set here
as configuration constants.
"""

import os
import sys
import maya.cmds as cmds

# ---------------------------------------------------------------------------
# sys.path block -- lets Maya find sibling modules
# ---------------------------------------------------------------------------
try:
    _THIS_DIR = os.path.dirname(os.path.abspath(__file__))
except NameError:
    _THIS_DIR = cmds.workspace(query=True, rootDirectory=True)

if _THIS_DIR not in sys.path:
    sys.path.insert(0, _THIS_DIR)

import room_geometry as geo
import room_materials as mat


# ---------------------------------------------------------------------------
# Room configuration
# ---------------------------------------------------------------------------

ROOM_WIDTH = 12       # X extent of the floor
ROOM_DEPTH = 12       # Z extent of the floor
WALL_HEIGHT = 5       # Height of each wall panel

# Material palette:  key -> (shader_name, (R, G, B))
MATERIAL_PALETTE = {
    "floor":     ("pale_wood",    (0.76, 0.64, 0.48)),
    "wall":      ("warm_plaster", (0.92, 0.88, 0.82)),
    "desk":      ("dark_wood",    (0.40, 0.26, 0.14)),
    "chair":     ("charcoal",     (0.25, 0.25, 0.28)),
    "bookshelf": ("mid_wood",     (0.55, 0.38, 0.22)),
    "bed":       ("soft_linen",   (0.85, 0.82, 0.76)),
    "couch":     ("sage_green",   (0.45, 0.55, 0.45)),
}


# ---------------------------------------------------------------------------
# Room builder
# ---------------------------------------------------------------------------

def build_room(position=(0, 0, 0)):
    """Assemble a complete cosy study room at the given position.

    Intentional layout (all furniture placed on y=0, sitting on the floor):

        Back wall  -- along X at z = -ROOM_DEPTH/2
        Left wall  -- along Z at x = -ROOM_WIDTH/2  (corner joint)

        Desk       -- against the left wall, pushed into the back corner
        Chair      -- in front of the desk, pulled out ready to sit
        Bookshelf  -- against the back wall, right-hand side
        Bed        -- right side of the room, parallel to the back wall
        Couch      -- centre-front of the room, facing the bed

    Args:
        position (tuple): (x, y, z) origin of the room. Default origin.

    Returns:
        str: Name of the top-level room group node.
    """
    px, py, pz = position
    hw = ROOM_WIDTH / 2.0   # half-width  (X)
    hd = ROOM_DEPTH / 2.0   # half-depth  (Z)
    parts = []

    # ---- Create material shaders ----------------------------------------
    shaders = {}
    for key, (name, color) in MATERIAL_PALETTE.items():
        shaders[key] = mat.create_material(name, color)

    # ---- Floor --------------------------------------------------------------
    floor = geo.create_floor(
        width=ROOM_WIDTH,
        depth=ROOM_DEPTH,
        position=(px, py, pz),
    )
    mat.assign_material(floor, shaders["floor"])
    parts.append(floor)

    # ---- Back wall (runs along X, closes the far end of the room) ----------
    back_wall = geo.create_wall(
        width=ROOM_WIDTH,
        height=WALL_HEIGHT,
        axis="x",
        position=(px, py, pz - hd),
    )
    mat.assign_material(back_wall, shaders["wall"])
    parts.append(back_wall)

    # ---- Left wall (runs along Z, closes the left side of the room) --------
    left_wall = geo.create_wall(
        width=ROOM_DEPTH,
        height=WALL_HEIGHT,
        axis="z",
        position=(px - hw, py, pz),
    )
    mat.assign_material(left_wall, shaders["wall"])
    parts.append(left_wall)

    # ---- Desk  -- tucked into the back-left corner
    desk = geo.create_desk(
        width=3.5,
        depth=1.5,
        height=1.5,
        position=(px - hw + 2.15, py, pz - hd + 1.15),
    )
    mat.assign_material(desk, shaders["desk"])
    parts.append(desk)

    # ---- Chair -- pulled 1.3 units forward from the desk so it clears the legs
    chair = geo.create_chair(
        seat_width=0.9,
        seat_depth=0.9,
        seat_height=1.0,
        back_height=0.8,
        position=(px - hw + 2.15, py, pz - hd + 3.0),
    )
    mat.assign_material(chair, shaders["chair"])
    parts.append(chair)

    # ---- Bookshelf -- against the back wall, right of centre
    bookshelf = geo.create_bookshelf(
        width=1.2,
        height=3.5,
        depth=0.4,
        shelves=4,
        position=(px + 2.5, py, pz - hd + 0.2),
    )
    mat.assign_material(bookshelf, shaders["bookshelf"])
    parts.append(bookshelf)

    # ---- Bed -- right side of the room, headboard near the back wall
    bed = geo.create_bed(
        width=2.2,
        length=3.5,
        height=0.6,
        position=(px + hw - 1.3, py, pz - hd + 2.15),
    )
    mat.assign_material(bed, shaders["bed"])
    parts.append(bed)

    # ---- Couch -- centre-front of the room, facing inward (toward the bed)
    couch = geo.create_couch(
        width=2.8,
        depth=1.0,
        seat_height=0.5,
        back_height=0.7,
        position=(px, py, pz + hd - 1.5),
    )
    mat.assign_material(couch, shaders["couch"])
    parts.append(couch)

    cmds.viewFit(allObjects=True)
    print("=== Cosy Bedroom Complete ===")
    print("  {} parts assembled.".format(len(parts)))

    return cmds.group(parts, name="cosy_bedroom_#")


# ---------------------------------------------------------------------------
if __name__ == "__main__":
    cmds.file(new=True, force=True)
    build_room()